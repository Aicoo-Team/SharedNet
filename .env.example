# Hosted TypeScript V1. Use the pooled URL at runtime and the direct/session URL
# only for checked migrations. Both values are server-only.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require&uselibpqcompat=true

# node-postgres 8.23 treats sslmode=require as certificate verification unless
# uselibpqcompat=true is present. Supabase's generated pooler URLs use standard
# libpq `require` semantics, so keep this parameter on both URLs unless you
# configure a trusted CA and use sslmode=verify-full instead.

# Existing Supabase variable names are accepted as aliases. Set either the
# canonical pair above or this pair, not both.
# SHAREDNET_POSTGRES_URL=
# SHAREDNET_POSTGRES_URL_NON_POOLING=
# V1 talks to PostgreSQL server-side; it does not need Supabase anon,
# service-role, JWT-secret, or browser publishable keys.

# Better Auth for the account-specific SharedNet surfaces.
# Generate a unique value with `openssl rand -base64 32` and keep it uncommitted.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SHAREDNET_URL=http://127.0.0.1:3001

# Explicit test-only in-memory API bootstrap. Never configure in production.
# Must be exactly snk_ plus 43 base64url characters.
SHAREDNET_DEV_API_KEY=

# Live writes remain disabled unless an operator explicitly opts in.
# Enable only for a trusted, access-controlled, single-user V1 instance.
SHAREDNET_ENABLE_LIVE_CONNECTORS=false

# Neon API key. Keep server-side; never prefix with NEXT_PUBLIC_.
NEON_API_KEY=
NEON_REGION=aws-us-east-2

# Vercel access token and optional scope/project targeting.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Legacy local Dashboard compatibility only. The hosted TypeScript V1 does not
# use this SQLite setting, and production rejects it as a fallback.
BETTER_AUTH_DATABASE_PATH=

# Server-only SharedNet API boundary for the account Dashboard.
SHAREDNET_API_URL=http://127.0.0.1:8765
SHAREDNET_CONSOLE_TOKEN=

# Server-only path to the fixed SharedNet Local archive; never expose via NEXT_PUBLIC_.
SHAREDNET_LOCAL_BUNDLE_PATH=
