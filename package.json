{
  "name": "sharednet-network-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "api:v1": "node --experimental-strip-types packages/server/src/dev-server.ts",
    "auth:migrate": "node --experimental-strip-types scripts/migrate-auth.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate-auth.mjs",
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start -p 3001",
    "sharednet": "node --experimental-strip-types packages/cli/src/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:v1": "vitest run packages/protocol packages/server packages/cli",
    "test:package:cli": "node scripts/cli-package-smoke.mjs",
    "test:e2e:v1": "node scripts/v1-four-codex-e2e.mjs",
    "test:e2e:postgres": "node scripts/v1-postgres-e2e.mjs",
    "test:e2e:dashboard": "node --experimental-strip-types scripts/dashboard-door-postgres-e2e.mjs",
    "scenario:chat": "node --experimental-strip-types scripts/scenarios/chat-scenario.mjs",
    "mem:generate": "node --experimental-strip-types scripts/mem/generate.mjs",
    "mem:evaluate": "node --experimental-strip-types scripts/mem/evaluate.mjs",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "demo:seed": "node --experimental-strip-types scripts/seed-demo-room.mjs",
    "credits:mint": "node --experimental-strip-types scripts/credits/mint-code.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.3",
    "@better-auth/cimd": "1.7.3",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/mcp": "1.7.3",
    "@better-auth/oauth-provider": "1.7.3",
    "@fontsource-variable/albert-sans": "5.3.0",
    "@fontsource-variable/anybody": "5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@sharednet/db": "workspace:*",
    "@vercel/analytics": "2.0.1",
    "better-auth": "1.7.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
