{
  "name": "sharednet-network-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "auth:migrate": "node --experimental-strip-types scripts/migrate-auth.mjs",
    "demo:seed": "node --experimental-strip-types scripts/seed-demo-account.mjs",
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "5.3.0",
    "@fontsource-variable/anybody": "5.3.0",
    "better-auth": "1.7.2",
    "better-sqlite3": "12.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
